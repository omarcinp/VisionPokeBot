# Layered on sdkconfig.defaults by tools/qemu.sh.

# QEMU emulates an OpenCores Ethernet MAC instead of the WiFi radio.
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_OPENETH=y
CONFIG_ETH_OPENETH_DMA_RX_BUFFER_NUM=4
CONFIG_ETH_OPENETH_DMA_TX_BUFFER_NUM=1

# QEMU's flash image must be exactly the configured flash size.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
